<!DOCTYPE html>
<html lang="ja">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="@BaseHref" />
    <script>
        // プロキシ配下 (SageMaker のポート転送 URL など) で開かれても動くよう、
        // 「アドレスバーのパス」から「サーバーが受け取ったパス」を差し引いた残りを接頭辞として base href を決める。
        // (プロキシの URL 形式や ProxyBasePath の設定に依存しない)
        (function () {
            var appPath = @((MarkupString)System.Text.Json.JsonSerializer.Serialize(HttpContext.Request.Path.Value ?? "/"));
            var p = decodeURI(location.pathname);
            var prefix = null;
            if (appPath === "/" && !p.endsWith("/")) {
                // 末尾の / が無いと相対パスがドメイン直下で解決されてしまうため付け直す
                location.replace(location.pathname + "/" + location.search + location.hash);
                return;
            }
            if (p.endsWith(appPath)) {
                prefix = p.substring(0, p.length - appPath.length);
            }
            if (prefix) {
                document.querySelector("base").setAttribute("href", prefix.replace(/\/$/, "") + "/");
            }
            console.log("[base] appPath=" + appPath + " location=" + p + " base=" + document.baseURI);
        })();
    </script>
    <ResourcePreloader />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["MyBlazorApp.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script>
        // Cookie の書き込み (MainLayout のテーマ保存で使う)。有効期限 1 年。
        // プロキシ配下でもサーバーに送られるよう path はドメイン直下にする
        window.appCookie = {
            set: function (name, value) {
                document.cookie = encodeURIComponent(name) + "=" + encodeURIComponent(value) +
                    "; path=/; max-age=31536000; samesite=lax";
            }
        };

        // Ctrl (Mac は Command)・Shift を押している間、html 要素に row-select-key クラスを付ける。
        // 表の編集欄はこのクラスがある間クリックを受け付けなくなり (app.css)、クリックが行の選択に使われる。
        // 入力欄の中のキー操作も確実に拾うため、window のキャプチャ段階で受け取る
        (function () {
            function update(e) {
                document.documentElement.classList.toggle("row-select-key", e.ctrlKey || e.metaKey || e.shiftKey);
            }
            window.addEventListener("keydown", update, true);
            window.addEventListener("keyup", update, true);
            // キーを押したまま別のウィンドウに移ると keyup が来ないので、戻ったときに外す
            window.addEventListener("blur", function () {
                document.documentElement.classList.remove("row-select-key");
            });
        })();

        // data-select-all 属性を付けた要素の中で Ctrl+A (Mac は Command+A) を押したとき、ブラウザ標準の「ページ全体の文字を選択」を止める。
        // 全選択そのものは各ページの onkeydown イベントで行う (Blazor 側の preventDefault 指定は全キーに効いてしまうためここで処理する)
        // 入力欄の中の Ctrl+A は、入力した文字の全選択として通常どおり動かす
        document.addEventListener("keydown", function (e) {
            if (e.target.closest && e.target.closest("input, textarea, [contenteditable]")) return;
            if ((e.ctrlKey || e.metaKey) && (e.key === "a" || e.key === "A") && e.target.closest && e.target.closest("[data-select-all]")) {
                e.preventDefault();
            }
        });
    </script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // プロキシ配下でも _framework/blazor.web.js や _blazor (SignalR) を正しいパスで解決させる
    private string BaseHref => $"{HttpContext.Request.PathBase}/";
}
