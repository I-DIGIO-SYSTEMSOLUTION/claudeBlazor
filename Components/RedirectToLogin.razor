@inject NavigationManager Nav

@* ログインしていない状態で、ログインが必要な画面を開いたときにログイン画面へ移る (ログイン後は元の画面に戻る)
   HTTP でのアクセスは Cookie 認証の OnRedirectToLogin がリダイレクトする。ここは画面内の遷移 (対話モード) の場合 *@

@code {
    protected override void OnInitialized()
    {
        string returnUrl = Uri.EscapeDataString(Nav.ToBaseRelativePath(Nav.Uri));
        Nav.NavigateTo($"{AuthConstants.LoginPath}?returnUrl={returnUrl}", forceLoad: true);
    }
}
