@page "/"
@inject NavigationManager Nav

<PageTitle>ホーム</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Blazor Server on SageMaker Code Editor</MudText>

<MudText Class="mb-4">このページは Interactive Server で動作しています。</MudText>

<MudSimpleTable Dense="true" Class="mb-4" Style="width: fit-content;">
    <tbody>
        <tr><th>BaseUri</th><td>@Nav.BaseUri</td></tr>
        <tr><th>Uri</th><td>@Nav.Uri</td></tr>
        <tr><th>サーバー時刻</th><td>@serverTime</td></tr>
        <tr><th>.NET</th><td>@Environment.Version</td></tr>
        <tr><th>OS</th><td>@System.Runtime.InteropServices.RuntimeInformation.OSDescription</td></tr>
    </tbody>
</MudSimpleTable>

<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="Refresh">サーバー時刻を更新</MudButton>

@code {
    private string serverTime = DateTime.Now.ToString("yyyy/MM/dd HH:mm:ss");

    private void Refresh()
    {
        // ← デバッグ確認用: ここにブレークポイントを置いてボタンを押す
        serverTime = DateTime.Now.ToString("yyyy/MM/dd HH:mm:ss");
    }
}
