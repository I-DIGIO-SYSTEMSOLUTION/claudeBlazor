@page "/counter"

<PageTitle>カウンター</PageTitle>

<h1>カウンター</h1>

<p role="status">現在のカウント: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">クリック</button>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        // ← デバッグ確認用: ここにブレークポイントを置いてボタンを押す
        currentCount++;
    }
}
