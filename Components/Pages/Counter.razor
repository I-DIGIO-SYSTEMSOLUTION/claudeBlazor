@page "/counter"

<PageTitle>カウンター</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">カウンター</MudText>

<MudText Class="mb-4" role="status">現在のカウント: @currentCount</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="IncrementCount">クリック</MudButton>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        // ← デバッグ確認用: ここにブレークポイントを置いてボタンを押す
        currentCount++;
    }
}
