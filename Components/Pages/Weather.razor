@page "/weather"
@attribute [StreamRendering]
@using LogicCommon
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<DbContextWeatherForecast> DbFactory

<PageTitle>天気予報</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">天気予報</MudText>

<MudText Class="mb-4">PostgreSQL の weather_forecasts テーブルから取得したデータを表示しています。</MudText>

@if (errorMessage != null)
{
    <MudAlert Severity="Severity.Error">データの取得に失敗しました: @errorMessage</MudAlert>
}
else if (forecasts == null)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    <MudText><em>読み込み中...</em></MudText>
}
else
{
    <MudTable Items="forecasts" Hover="true" Striped="true" Elevation="1">
        <HeaderContent>
            <MudTh>日付</MudTh>
            <MudTh aria-label="摂氏の気温">気温 (℃)</MudTh>
            <MudTh aria-label="華氏の気温">気温 (℉)</MudTh>
            <MudTh>概況</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="日付">@context.Date.ToShortDateString()</MudTd>
            <MudTd DataLabel="気温 (℃)">@context.TemperatureC</MudTd>
            <MudTd DataLabel="気温 (℉)">@context.TemperatureF</MudTd>
            <MudTd DataLabel="概況">@context.Summary</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private WeatherForecast[]? forecasts;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            forecasts = await db.WeatherForecasts
                .AsNoTracking()
                .OrderBy(f => f.Date)
                .ToArrayAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}
