@page "/weather"
@attribute [StreamRendering]

<PageTitle>天気予報</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">天気予報</MudText>

<MudText Class="mb-4">このコンポーネントはデータの表示例です。</MudText>

@if (forecasts == null)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    <MudText><em>読み込み中...</em></MudText>
}
else
{
    <MudTable Items="forecasts" Hover="true" Striped="true" Elevation="1">
        <HeaderContent>
            <MudTh>日付</MudTh>
            <MudTh aria-label="摂氏の気温">気温 (℃)</MudTh>
            <MudTh aria-label="華氏の気温">気温 (℉)</MudTh>
            <MudTh>概況</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="日付">@context.Date.ToShortDateString()</MudTd>
            <MudTd DataLabel="気温 (℃)">@context.TemperatureC</MudTd>
            <MudTd DataLabel="気温 (℉)">@context.TemperatureF</MudTd>
            <MudTd DataLabel="概況">@context.Summary</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private WeatherForecast[]? forecasts;

    protected override async Task OnInitializedAsync()
    {
        // ストリーミング レンダリングを示すため、非同期の読み込みを模擬する
        await Task.Delay(500);

        var startDate = DateOnly.FromDateTime(DateTime.Now);
        var summaries = new[] { "極寒", "厳寒", "肌寒い", "涼しい", "穏やか", "暖かい", "心地よい", "暑い", "蒸し暑い", "酷暑" };
        forecasts = Enumerable.Range(1, 5).Select(index => new WeatherForecast
        {
            Date = startDate.AddDays(index),
            TemperatureC = Random.Shared.Next(-20, 55),
            Summary = summaries[Random.Shared.Next(summaries.Length)]
        }).ToArray();
    }

    private class WeatherForecast
    {
        public DateOnly Date { get; set; }
        public int TemperatureC { get; set; }
        public string? Summary { get; set; }
        public int TemperatureF => 32 + (int)(TemperatureC / 0.5556);
    }
}
