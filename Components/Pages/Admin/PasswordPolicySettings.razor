@page "/password-policy"
@attribute [Authorize(Roles = AuthConstants.AdminRole)]
@using System.Security.Claims
@inject SecurityPolicyService PolicyService
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject ILogger<PasswordPolicySettings> Logger

@* パスワードポリシーと自動ログアウトの時間の変更 (ADMIN ロールのみ)。値は security_policies (id = 1) に保存する *@
<PageTitle>パスワードポリシー</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-4">
    <MudPaper Class="pa-6" Elevation="2">
        <MudText Typo="Typo.h5" GutterBottom="true">パスワードポリシー</MudText>

        @if (Original == null || input == null)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        }
        else
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
                変更したポリシーは、これから設定するパスワード (ユーザー作成・パスワード変更・再設定) に使われます。設定済みのパスワードはそのまま使えます。
            </MudAlert>
            <ErrorList Errors="errors" />

            <EditForm Model="input" OnSubmit="SaveAsync">
                <MudStack Spacing="3">
                    <MudText Typo="Typo.subtitle1">文字数</MudText>
                    <MudStack Row="true" Spacing="3">
                        <MudNumericField T="int" @bind-Value="input.MinLength" Label="最小文字数" Variant="Variant.Outlined" Immediate="true"
                                         Min="1" Max="SecurityPolicyService.MaxPasswordLength" />
                        <MudNumericField T="int" @bind-Value="input.MaxLength" Label="最大文字数" Variant="Variant.Outlined" Immediate="true"
                                         Min="1" Max="SecurityPolicyService.MaxPasswordLength" />
                    </MudStack>

                    <MudText Typo="Typo.subtitle1" Class="mt-2">文字種</MudText>
                    <div>
                        <MudSwitch T="bool" @bind-Value="input.RequireUppercase" Color="Color.Primary" Label="英大文字を必須にする" />
                        <MudSwitch T="bool" @bind-Value="input.RequireLowercase" Color="Color.Primary" Label="英小文字を必須にする" />
                        <MudSwitch T="bool" @bind-Value="input.RequireDigit" Color="Color.Primary" Label="数字を必須にする" />
                        <MudSwitch T="bool" @bind-Value="input.RequireSymbol" Color="Color.Primary" Label="記号を必須にする" />
                    </div>
                    <MudNumericField T="int" @bind-Value="input.MinCharTypes" Label="最低限含める文字種の数" Variant="Variant.Outlined" Immediate="true"
                                     Min="0" Max="4" HelperText="英大文字・英小文字・数字・記号のうち何種類以上を含めるか (0 は制限なし)" />

                    <MudText Typo="Typo.subtitle1" Class="mt-2">その他</MudText>
                    <MudSwitch T="bool" @bind-Value="input.DisallowLoginId" Color="Color.Primary" Label="ログイン ID を含むパスワードを禁止する" />
                    <MudNumericField T="int" @bind-Value="input.HistoryCount" Label="再利用を禁止する世代数" Variant="Variant.Outlined" Immediate="true"
                                     Min="0" Max="SecurityPolicyService.MaxHistoryCount" HelperText="現在のパスワードを含む直近の何回分と同じパスワードを禁止するか (0 は制限なし)" />
                    <MudNumericField T="int" @bind-Value="input.ExpiryDays" Label="有効期限 (日)" Variant="Variant.Outlined" Immediate="true"
                                     Min="0" Max="SecurityPolicyService.MaxExpiryDays" HelperText="0 は無期限" />
                    @if (input.ExpiryDays > 0)
                    {
                        <MudNumericField T="int" @bind-Value="input.ExpiryWarningDays" Label="有効期限切れ警告表示日数" Variant="Variant.Outlined" Immediate="true"
                                         Min="0" Max="SecurityPolicyService.MaxExpiryDays"
                                         HelperText="有効期限の何日前から、ログイン時に警告を表示するか (1 日 1 回。0 は表示しない)" />
                    }
                    @if (input.ExpiryDays > 0 && input.ExpiryDays != Original.ExpiryDays)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true">
                            有効期限は次のログインから判定に使われます。最後にパスワードを設定してから @input.ExpiryDays 日を過ぎているユーザーは、
                            次のログインでパスワードの再設定を求められます。
                        </MudAlert>
                    }

                    <MudText Typo="Typo.subtitle1" Class="mt-2">自動ログアウト</MudText>
                    <MudStack Row="true" Spacing="3">
                        <MudNumericField T="int" @bind-Value="input.IdleTimeoutMinutes" Label="自動ログアウトまでの時間 (分)" Variant="Variant.Outlined" Immediate="true"
                                         Min="1" Max="SecurityPolicyService.MaxIdleTimeoutMinutes" HelperText="最後の操作 (またはサーバー処理の終了) からの時間" />
                        <MudNumericField T="int" @bind-Value="input.TimeoutWarningSeconds" Label="警告を出す時間 (秒前)" Variant="Variant.Outlined" Immediate="true"
                                         Min="0" HelperText="ログアウトの何秒前に警告を出すか (0 は警告なし)" />
                    </MudStack>
                    @if (input.IdleTimeoutMinutes != Original.IdleTimeoutMinutes || input.TimeoutWarningSeconds != Original.TimeoutWarningSeconds)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true">
                            自動ログアウトの時間は、ログイン中のユーザーにもすぐに使われます。
                            短くした場合、最後の操作からその時間を過ぎているユーザーは、保存後まもなくログアウトします。
                        </MudAlert>
                    }

                    @* 入力中の値で、ユーザー作成などの画面に出る説明文がどうなるかを見せる *@
                    <MudPaper Outlined="true" Class="pa-3 mt-2">
                        <MudText Typo="Typo.caption">変更後のパスワードの条件</MudText>
                        <MudText Typo="Typo.body2">@PasswordPolicy.Describe(input.ToPolicy())</MudText>
                    </MudPaper>

                    <MudStack Row="true" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                        <MudText Typo="Typo.caption" Class="mr-auto">最終更新: @AppTime.Format(Original.UpdatedAt)</MudText>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Undo"
                                   Disabled="@(!Changed || busy)" OnClick="Revert">
                            元に戻す
                        </MudButton>
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                                   Disabled="@(!Changed || busy || !RendererInfo.IsInteractive)">
                            保存
                        </MudButton>
                    </MudStack>
                </MudStack>
            </EditForm>
        }
    </MudPaper>
</MudContainer>

@code {
    // 読み込んだ時点の値。プリレンダリングで読んだ値を対話モードに引き継ぐ (切り替わるときに読み込み中の表示に戻らないように)
    [PersistentState] public PasswordPolicyInput? Original { get; set; }

    // 画面で編集中の値
    private PasswordPolicyInput? input;
    private IReadOnlyList<string> errors = [];
    private bool busy;

    private bool Changed => input != null && input != Original;

    protected override async Task OnInitializedAsync()
    {
        Original ??= await PolicyService.GetPasswordPolicyAsync();
        input = Original with { };
    }

    private void Revert()
    {
        input = Original! with { };
        errors = [];
    }

    private async Task SaveAsync()
    {
        if (busy || input == null || !Changed)
        {
            return;
        }
        busy = true;
        errors = [];
        try
        {
            ClaimsPrincipal user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
            long adminId = long.Parse(user.FindFirst(ClaimTypes.NameIdentifier)!.Value);

            AccountResult result = await PolicyService.UpdatePasswordPolicyAsync(input, adminId);
            if (!result.Succeeded)
            {
                errors = result.Errors;
                return;
            }

            // 保存後の値 (更新日時を含む) を読み直す
            Original = await PolicyService.GetPasswordPolicyAsync();
            input = Original with { };
            Snackbar.Add("パスワードポリシーを保存しました。", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "パスワードポリシーを保存できませんでした。");
            errors = ["保存中にエラーが発生しました。"];
        }
        finally
        {
            busy = false;
        }
    }
}
