@page "/change-password"
@using System.Security.Claims
@inject UserAccountService AccountService
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<ChangePassword> Logger

<PageTitle>パスワード変更</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-4">
    <MudPaper Class="pa-6" Elevation="2">
        <MudText Typo="Typo.h5" GutterBottom="true">パスワード変更</MudText>

        @if (completed)
        {
            <MudAlert Severity="Severity.Success">パスワードを変更しました。他の端末でのログインは終了しました。</MudAlert>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-4">パスワードの条件: @PolicyText</MudText>
            <ErrorList Errors="errors" />
            <EditForm Model="this" OnSubmit="SubmitAsync">
                <MudStack Spacing="3">
                    <MudTextField @bind-Value="currentPassword" Label="現在のパスワード" Variant="Variant.Outlined" Immediate="true"
                                  InputType="InputType.Password" autocomplete="current-password" />
                    <MudTextField @bind-Value="newPassword" Label="新しいパスワード" Variant="Variant.Outlined" Immediate="true"
                                  InputType="InputType.Password" autocomplete="new-password" />
                    <MudTextField @bind-Value="newPasswordConfirm" Label="新しいパスワード (確認)" Variant="Variant.Outlined" Immediate="true"
                                  InputType="InputType.Password" autocomplete="new-password" />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                               Disabled="@(busy || !RendererInfo.IsInteractive)">
                        変更
                    </MudButton>
                </MudStack>
            </EditForm>
        }
    </MudPaper>
</MudContainer>

@code {
    // プリレンダリングで取得した値を対話モードに引き継ぐ
    [PersistentState] public string? PolicyText { get; set; }
    private string currentPassword = "";
    private string newPassword = "";
    private string newPasswordConfirm = "";
    private IReadOnlyList<string> errors = [];
    private bool busy;
    private bool completed;

    protected override async Task OnInitializedAsync()
    {
        PolicyText ??= PasswordPolicy.Describe(await AccountService.GetSecurityPolicyAsync());
    }

    private async Task SubmitAsync()
    {
        if (busy)
        {
            return;
        }
        busy = true;
        errors = [];
        try
        {
            ClaimsPrincipal user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
            long userId = long.Parse(user.FindFirst(ClaimTypes.NameIdentifier)!.Value);
            Guid sessionId = Guid.Parse(user.FindFirst(AuthConstants.SessionIdClaim)!.Value);

            // 操作中のこの端末のセッションは残し、他の端末のセッションは終了する
            AccountResult result = await AccountService.ChangePasswordAsync(userId, currentPassword, newPassword, newPasswordConfirm, sessionId);
            if (result.Succeeded)
            {
                completed = true;
            }
            else
            {
                errors = result.Errors;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "パスワードを変更できませんでした。");
            errors = ["パスワードの変更中にエラーが発生しました。しばらくしてからもう一度お試しください。"];
        }
        finally
        {
            busy = false;
            currentPassword = newPassword = newPasswordConfirm = "";
        }
    }
}
