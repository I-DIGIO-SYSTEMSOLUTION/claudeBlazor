@page "/forgot-password"
@attribute [AllowAnonymous]
@inject PasswordResetService PasswordResetService
@inject ClientConnectionInfo ClientInfo

<PageTitle>パスワードを忘れた場合</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-8">
    <MudPaper Class="pa-6" Elevation="2">
        <MudText Typo="Typo.h5" GutterBottom="true">パスワードを忘れた場合</MudText>

        @if (sent)
        {
            @* 登録されていないメールアドレスでも同じ表示にする (登録の有無を推測されないように) *@
            <MudAlert Severity="Severity.Success" Class="mb-4">
                入力されたメールアドレスが登録されている場合、パスワード再設定用のメールを送信しました。
                メールに記載されたリンクから、新しいパスワードを設定してください。
            </MudAlert>
        }
        else
        {
            <MudText Class="mb-4">登録しているメールアドレスを入力してください。パスワード再設定用のリンクをお送りします。</MudText>
            <ErrorList Errors="errors" />
            @* ブラウザ標準の入力チェック (type="email") ではなく、画面のメッセージで知らせる *@
            <EditForm Model="this" OnSubmit="Submit" novalidate>
                <MudStack Spacing="3">
                    <MudTextField @bind-Value="email" Label="メールアドレス" Variant="Variant.Outlined" Immediate="true"
                                  InputType="InputType.Email" autocomplete="email" AutoFocus="true" />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                               Disabled="@(!RendererInfo.IsInteractive)">
                        送信
                    </MudButton>
                </MudStack>
            </EditForm>
        }

        <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
            <MudLink Href="@AuthConstants.LoginPath" Typo="Typo.body2">ログイン画面に戻る</MudLink>
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private string email = "";
    private bool sent;
    private IReadOnlyList<string> errors = [];

    private void Submit()
    {
        errors = [];
        if (!UserAccountService.IsValidEmail(email.Trim()))
        {
            errors = ["メールアドレスの形式が正しくありません。"];
            return;
        }

        // メールの送信は裏で行い、すぐに戻る (送信の成否は画面に出さない)
        PasswordResetService.Request(email, ClientInfo.IpAddress);
        sent = true;
    }
}
