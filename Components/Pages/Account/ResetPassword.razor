@page "/reset-password"
@attribute [AllowAnonymous]
@inject PasswordResetService PasswordResetService
@inject UserAccountService AccountService
@inject NavigationManager Nav
@inject ILogger<ResetPassword> Logger

<PageTitle>パスワードの再設定</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-8">
    <MudPaper Class="pa-6" Elevation="2">
        <MudText Typo="Typo.h5" GutterBottom="true">パスワードの再設定</MudText>

        @if (ValidToken == null)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        }
        else if (ValidToken == false)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">
                このリンクは無効か、有効期限が切れています。もう一度パスワードの再設定を申請してください。
            </MudAlert>
            <MudLink Href="forgot-password">パスワードの再設定を申請する</MudLink>
        }
        else
        {
            @if (Expired == true)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-4">パスワードの有効期限が切れています。新しいパスワードを設定してください。</MudAlert>
            }
            <MudText Typo="Typo.body2" Class="mb-4">パスワードの条件: @PolicyText</MudText>
            <ErrorList Errors="errors" />
            <EditForm Model="this" OnSubmit="SubmitAsync">
                <MudStack Spacing="3">
                    <MudTextField @bind-Value="newPassword" Label="新しいパスワード" Variant="Variant.Outlined" Immediate="true"
                                  InputType="InputType.Password" autocomplete="new-password" AutoFocus="true" />
                    <MudTextField @bind-Value="newPasswordConfirm" Label="新しいパスワード (確認)" Variant="Variant.Outlined" Immediate="true"
                                  InputType="InputType.Password" autocomplete="new-password" />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                               Disabled="@(busy || !RendererInfo.IsInteractive)">
                        パスワードを設定
                    </MudButton>
                </MudStack>
            </EditForm>
        }
    </MudPaper>
</MudContainer>

@code {
    [SupplyParameterFromQuery] public string? Token { get; set; }

    // パスワードの有効期限切れでログインから来た場合は true
    [SupplyParameterFromQuery] public bool? Expired { get; set; }

    // プリレンダリングで確認した結果を対話モードに引き継ぐ (切り替わるときに読み込み中の表示に戻らないように)
    [PersistentState] public bool? ValidToken { get; set; }
    [PersistentState] public string? PolicyText { get; set; }
    private string newPassword = "";
    private string newPasswordConfirm = "";
    private IReadOnlyList<string> errors = [];
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            PolicyText ??= PasswordPolicy.Describe(await AccountService.GetSecurityPolicyAsync());
            ValidToken ??= await PasswordResetService.IsValidTokenAsync(Token);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "パスワード再設定のリンクを確認できませんでした。");
            ValidToken = false;
        }
    }

    private async Task SubmitAsync()
    {
        if (busy)
        {
            return;
        }
        busy = true;
        errors = [];
        try
        {
            AccountResult result = await PasswordResetService.ResetAsync(Token, newPassword, newPasswordConfirm, Expired == true);
            if (result.Succeeded)
            {
                Nav.NavigateTo($"{AuthConstants.LoginPath}?reason=reset");
                return;
            }
            errors = result.Errors;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "パスワードを再設定できませんでした。");
            errors = ["パスワードの設定中にエラーが発生しました。しばらくしてからもう一度お試しください。"];
        }
        finally
        {
            busy = false;
        }
    }
}
