@page "/Error"
@using System.Diagnostics

<PageTitle>エラー</PageTitle>

<MudText Typo="Typo.h3" Color="Color.Error">エラー</MudText>
<MudText Typo="Typo.h5" Color="Color.Error" GutterBottom="true">リクエストの処理中にエラーが発生しました。</MudText>

@if (ShowRequestId)
{
    <p>
        <strong>リクエスト ID:</strong> <code>@RequestId</code>
    </p>
}

<h3>開発モード</h3>
<p>
    <strong>Development</strong> 環境に切り替えると、発生したエラーの詳細な情報が表示されます。
</p>
<p>
    <strong>デプロイしたアプリケーションでは Development 環境を有効にしないでください。</strong>
    例外に含まれる機密情報がエンド ユーザーに表示されるおそれがあります。
    ローカルでデバッグする場合は、環境変数 <strong>ASPNETCORE_ENVIRONMENT</strong> を <strong>Development</strong> に設定し、
    アプリを再起動して <strong>Development</strong> 環境を有効にしてください。
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
