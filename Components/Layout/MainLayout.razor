@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject ClientConnectionInfo ClientInfo

<MudThemeProvider Theme="@AppThemes.Find(themeKey).Theme" IsDarkMode="isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6">MyBlazorApp</MudText>
        <MudSpacer />
        <MudLink Href="https://learn.microsoft.com/aspnet/core/" Target="_blank" Color="Color.Inherit" Class="mr-2">このアプリについて</MudLink>
        <ThemeMenu ThemeKey="@themeKey" ThemeKeyChanged="ChangeThemeAsync"
                   IsDarkMode="isDarkMode" IsDarkModeChanged="ChangeDarkModeAsync" />
        @* メニューはログインしているときだけ表示する (ログイン画面などでは出さない) *@
        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.body2" Class="ml-2 d-none d-sm-flex">@context.User.Identity?.Name さん</MudText>
                <NavMenu />
                @* 操作が無い時間を監視し、規定の時間を過ぎたらログアウトする *@
                <SessionMonitor />
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    予期しないエラーが発生しました。
    <a href="." class="reload">再読み込み</a>
    <span class="dismiss">🗙</span>
</div>


@code {
    // 選んだテーマは Cookie に保存する。プリレンダリング (最初の HTML) の時点でサーバーが Cookie を読んでテーマを決めるので、
    // 初期表示から選んだテーマの色になる (localStorage だと表示後にしか読めず、一瞬既定の色が出てしまう)
    private const string ThemeKeyCookieName = "MyBlazorApp.Theme";
    private const string DarkModeCookieName = "MyBlazorApp.DarkMode";

    // プリレンダリング中だけ値が入る (対話モードになると null)
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    // プリレンダリングで決めた値を、対話モードの描画に引き継ぐ (対話モードでは HttpContext が使えないため)
    [PersistentState]
    public string? PersistedThemeKey { get; set; }

    [PersistentState]
    public bool? PersistedDarkMode { get; set; }

    // 接続元の IP・User-Agent (ログイン履歴と IP 単位の試行制限で使う)。
    // 対話モードでは HttpContext が使えないので、プリレンダリングのときに取得して引き継ぐ
    [PersistentState]
    public string? PersistedClientIp { get; set; }

    [PersistentState]
    public string? PersistedUserAgent { get; set; }

    private string themeKey = AppThemes.All[0].Key;
    private bool isDarkMode;

    protected override void OnInitialized()
    {
        if (HttpContext != null)
        {
            PersistedThemeKey = HttpContext.Request.Cookies[ThemeKeyCookieName];
            PersistedDarkMode = HttpContext.Request.Cookies[DarkModeCookieName] == "true";
            PersistedClientIp = HttpContext.Connection.RemoteIpAddress?.ToString();
            PersistedUserAgent = HttpContext.Request.Headers.UserAgent.ToString();
        }

        if (PersistedClientIp != null)
        {
            ClientInfo.IpAddress = PersistedClientIp;
            ClientInfo.UserAgent = PersistedUserAgent;
        }

        themeKey = AppThemes.Find(PersistedThemeKey).Key;
        isDarkMode = PersistedDarkMode ?? false;
    }

    private async Task ChangeThemeAsync(string key)
    {
        themeKey = key;
        await SaveAsync(ThemeKeyCookieName, key);
    }

    private async Task ChangeDarkModeAsync(bool value)
    {
        isDarkMode = value;
        await SaveAsync(DarkModeCookieName, value ? "true" : "false");
    }

    // Cookie の書き込みは App.razor の appCookie.set (JS) で行う
    private async Task SaveAsync(string name, string value)
    {
        try
        {
            await JS.InvokeVoidAsync("appCookie.set", name, value);
        }
        catch (JSException)
        {
            // 保存できなくても画面上の切り替えは有効
        }
    }
}
