<?xml version="1.0" encoding="utf-8"?>
<!-- log4net の設定。Program.cs で読み込み、このファイルの変更は再起動なしで反映される -->
<!--
  <コンテンツルート>/logs/ に、日付とログレベルごとのファイルへ出力する (例: 20261004_app_DEBUG.log)。
  日付が変わると新しいファイルに切り替わる。1 日で 10MB を超えた場合は 20261004_app_DEBUG.log.1 のように連番で退避する。
  日付はサーバーのローカル時刻 (タイムゾーンの設定) に従う。
-->
<log4net>
  <!-- DEBUG のみ (実行した SQL など) -->
  <appender name="DEBUGFile" type="log4net.Appender.RollingFileAppender">
    <file type="log4net.Util.PatternString" value="%property{LogDir}/" />
    <datePattern value="yyyyMMdd'_app_DEBUG.log'" />
    <staticLogFileName value="false" />
    <rollingStyle value="Composite" />
    <maximumFileSize value="10MB" />
    <maxSizeRollBackups value="10" />
    <appendToFile value="true" />
    <encoding value="utf-8" />
    <filter type="log4net.Filter.LevelRangeFilter">
      <levelMin value="DEBUG" />
      <levelMax value="DEBUG" />
    </filter>
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%thread] %-5level %logger - %message%newline" />
    </layout>
  </appender>
  <!-- INFO のみ -->
  <appender name="INFOFile" type="log4net.Appender.RollingFileAppender">
    <file type="log4net.Util.PatternString" value="%property{LogDir}/" />
    <datePattern value="yyyyMMdd'_app_INFO.log'" />
    <staticLogFileName value="false" />
    <rollingStyle value="Composite" />
    <maximumFileSize value="10MB" />
    <maxSizeRollBackups value="10" />
    <appendToFile value="true" />
    <encoding value="utf-8" />
    <filter type="log4net.Filter.LevelRangeFilter">
      <levelMin value="INFO" />
      <levelMax value="INFO" />
    </filter>
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%thread] %-5level %logger - %message%newline" />
    </layout>
  </appender>
  <!-- WARN のみ -->
  <appender name="WARNFile" type="log4net.Appender.RollingFileAppender">
    <file type="log4net.Util.PatternString" value="%property{LogDir}/" />
    <datePattern value="yyyyMMdd'_app_WARN.log'" />
    <staticLogFileName value="false" />
    <rollingStyle value="Composite" />
    <maximumFileSize value="10MB" />
    <maxSizeRollBackups value="10" />
    <appendToFile value="true" />
    <encoding value="utf-8" />
    <filter type="log4net.Filter.LevelRangeFilter">
      <levelMin value="WARN" />
      <levelMax value="WARN" />
    </filter>
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%thread] %-5level %logger - %message%newline" />
    </layout>
  </appender>
  <!-- ERROR と FATAL -->
  <appender name="ERRORFile" type="log4net.Appender.RollingFileAppender">
    <file type="log4net.Util.PatternString" value="%property{LogDir}/" />
    <datePattern value="yyyyMMdd'_app_ERROR.log'" />
    <staticLogFileName value="false" />
    <rollingStyle value="Composite" />
    <maximumFileSize value="10MB" />
    <maxSizeRollBackups value="10" />
    <appendToFile value="true" />
    <encoding value="utf-8" />
    <filter type="log4net.Filter.LevelRangeFilter">
      <levelMin value="ERROR" />
      <levelMax value="FATAL" />
    </filter>
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%thread] %-5level %logger - %message%newline" />
    </layout>
  </appender>

  <!-- 実行した SQL は DatabaseConnectionHelper のロガーに DEBUG で出力される。不要なら INFO 以上にする -->
  <logger name="LogicCommon.DatabaseConnectionHelper">
    <level value="DEBUG" />
  </logger>

  <root>
    <level value="INFO" />
    <appender-ref ref="DEBUGFile" />
    <appender-ref ref="INFOFile" />
    <appender-ref ref="WARNFile" />
    <appender-ref ref="ERRORFile" />
  </root>
</log4net>
